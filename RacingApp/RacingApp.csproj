<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- LibreHardwareMonitorLib ships its implementation only under runtimes/win-*. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared with the console prototype. -->
    <Compile Include="..\RacingMonitor\BoardProfile.cs" Link="Shared\BoardProfile.cs" />
    <None Include="..\RacingMonitor\BoardConfig.ini" Link="BoardConfig.ini" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
