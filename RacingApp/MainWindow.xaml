<Window x:Class="RacingApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Racing Studio" Height="640" Width="920" MinWidth="780" MinHeight="540"
        Background="#16181D" Foreground="#E6E6E6" FontFamily="Segoe UI" FontSize="13"
        Loaded="OnLoaded" Closed="OnClosed">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#1F2229" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="8" />
        </Style>
        <Style x:Key="Header" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="SubHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9AA0AA" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2C313A" />
            <Setter Property="Foreground" Value="#E6E6E6" />
            <Setter Property="BorderBrush" Value="#3A404B" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2C313A" />
            <Setter Property="Foreground" Value="#E6E6E6" />
            <Setter Property="BorderBrush" Value="#3A404B" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>
        <DataTemplate x:Key="SensorTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Foreground="#C8CCD4" />
                <TextBlock Grid.Column="1" Text="{Binding ValueText}" FontFamily="Consolas" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="BoardText" Grid.ColumnSpan="2" Margin="16,12,16,0" Foreground="#9AA0AA"
                   TextWrapping="Wrap" Text="Carregando hardware..." />

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Monitoramento" Style="{StaticResource Header}" />
                    <TextBlock Text="TEMPERATURAS" Style="{StaticResource SubHeader}" />
                    <ItemsControl x:Name="TemperatureList" ItemTemplate="{StaticResource SensorTemplate}" />
                    <TextBlock Text="FANS" Style="{StaticResource SubHeader}" />
                    <ItemsControl x:Name="FanList" ItemTemplate="{StaticResource SensorTemplate}" />
                    <TextBlock Text="TENSÕES" Style="{StaticResource SubHeader}" />
                    <ItemsControl x:Name="VoltageList" ItemTemplate="{StaticResource SensorTemplate}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="LEDs — conector 5V" Style="{StaticResource Header}" />
                <StackPanel x:Name="LedPanel" IsEnabled="False">
                    <Border x:Name="Preview" Height="72" CornerRadius="6" Margin="0,6,0,0"
                            BorderBrush="#3A404B" BorderThickness="1" Background="#2C313A" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="36" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="R" VerticalAlignment="Center" Foreground="#FF6B6B" />
                        <Slider x:Name="RedSlider" Grid.Column="1" Maximum="255" VerticalAlignment="Center"
                                IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnSliderChanged" />
                        <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=RedSlider}" FontFamily="Consolas"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" />
                        <TextBlock Grid.Row="1" Text="G" VerticalAlignment="Center" Foreground="#6BDB7B" />
                        <Slider x:Name="GreenSlider" Grid.Row="1" Grid.Column="1" Maximum="255" VerticalAlignment="Center"
                                IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnSliderChanged" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Value, ElementName=GreenSlider}" FontFamily="Consolas"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" />
                        <TextBlock Grid.Row="2" Text="B" VerticalAlignment="Center" Foreground="#6BA8FF" />
                        <Slider x:Name="BlueSlider" Grid.Row="2" Grid.Column="1" Maximum="255" VerticalAlignment="Center"
                                IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnSliderChanged" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Value, ElementName=BlueSlider}" FontFamily="Consolas"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Hex" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#9AA0AA" />
                        <TextBox x:Name="HexBox" Width="96" KeyDown="OnHexKeyDown" LostFocus="OnHexLostFocus" />
                    </StackPanel>

                    <TextBlock Text="CORES RÁPIDAS" Style="{StaticResource SubHeader}" />
                    <WrapPanel x:Name="Swatches" />

                    <TextBlock Text="EFEITO" Style="{StaticResource SubHeader}" />
                    <ComboBox x:Name="EffectBox" Width="200" HorizontalAlignment="Left" />

                    <TextBlock Text="VELOCIDADE" Style="{StaticResource SubHeader}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="lento" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#9AA0AA" />
                        <!-- Same scale as RCGTII's speed slider: register 0xAB = 255 - position (1..255). -->
                        <Slider x:Name="SpeedSlider" Grid.Column="1" Minimum="0" Maximum="254" VerticalAlignment="Center"
                                IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnSpeedChanged" />
                        <TextBlock Grid.Column="2" Text="rápido" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#9AA0AA" />
                    </Grid>
                    <TextBlock x:Name="SpeedText" FontFamily="Consolas" Foreground="#9AA0AA" Margin="0,2,0,0" />

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Aplicar nos LEDs" Click="OnApply" />
                        <Button Content="Restaurar original" Click="OnRestore" />
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="LedStatus" TextWrapping="Wrap" Margin="0,14,0,0" Foreground="#9AA0AA"
                           Text="Procurando o controlador de LEDs..." />
            </StackPanel>
        </Border>
    </Grid>
</Window>
