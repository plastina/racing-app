<UserControl x:Class="RacingApp.LedEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="0,8,0,0">
        <TextBlock Text="EFEITO" Style="{StaticResource SubHeader}" Margin="0,0,0,4" />
        <ComboBox x:Name="EffectBox" Width="240" HorizontalAlignment="Left" SelectionChanged="OnEffectChanged" />
        <TextBlock x:Name="AppEffectNote" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,6,0,0"
                   Foreground="#E0B860" FontSize="12"
                   Text="Efeito do app: calculado pelo Racing Studio. Funciona enquanto o app estiver aberto (pode minimizar)." />

        <!-- Shown for the chips' effects and the app effects that use a single colour. -->
        <StackPanel x:Name="ColorSection">
            <TextBlock Text="COR" Style="{StaticResource SubHeader}" />
            <Border x:Name="Preview" Height="48" CornerRadius="6"
                    BorderBrush="#3A404B" BorderThickness="1" Background="#2C313A" />

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="36" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="28" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="28" />
                </Grid.RowDefinitions>
                <TextBlock Text="R" VerticalAlignment="Center" Foreground="#FF6B6B" />
                <Slider x:Name="RedSlider" Grid.Column="1" Maximum="255" VerticalAlignment="Center"
                        IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnSliderChanged" />
                <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=RedSlider}" FontFamily="Consolas"
                           VerticalAlignment="Center" HorizontalAlignment="Right" />
                <TextBlock Grid.Row="1" Text="G" VerticalAlignment="Center" Foreground="#6BDB7B" />
                <Slider x:Name="GreenSlider" Grid.Row="1" Grid.Column="1" Maximum="255" VerticalAlignment="Center"
                        IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnSliderChanged" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Value, ElementName=GreenSlider}" FontFamily="Consolas"
                           VerticalAlignment="Center" HorizontalAlignment="Right" />
                <TextBlock Grid.Row="2" Text="B" VerticalAlignment="Center" Foreground="#6BA8FF" />
                <Slider x:Name="BlueSlider" Grid.Row="2" Grid.Column="1" Maximum="255" VerticalAlignment="Center"
                        IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnSliderChanged" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Value, ElementName=BlueSlider}" FontFamily="Consolas"
                           VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="Hex" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#9AA0AA" />
                <TextBox x:Name="HexBox" Width="96" KeyDown="OnHexKeyDown" LostFocus="OnHexLostFocus" />
            </StackPanel>

            <TextBlock Text="CORES RÁPIDAS" Style="{StaticResource SubHeader}" />
            <WrapPanel x:Name="Swatches" />
        </StackPanel>

        <!-- Cor pela temperatura -->
        <StackPanel x:Name="TempPanel" Visibility="Collapsed">
            <TextBlock Text="FAIXA DE TEMPERATURA DA CPU" Style="{StaticResource SubHeader}" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="azul em" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#9AA0AA" />
                <TextBox x:Name="TempMinBox" Width="44" Text="40" />
                <TextBlock Text="°C · vermelho em" VerticalAlignment="Center" Margin="6,0,6,0" Foreground="#9AA0AA" />
                <TextBox x:Name="TempMaxBox" Width="44" Text="80" />
                <TextBlock Text="°C" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="#9AA0AA" />
            </StackPanel>
        </StackPanel>

        <!-- Gradiente -->
        <StackPanel x:Name="GradientPanel" Visibility="Collapsed">
            <TextBlock Text="CORES DO GRADIENTE" Style="{StaticResource SubHeader}" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <Border x:Name="Gradient1Preview" Width="22" Height="22" CornerRadius="4" Margin="0,0,6,0" />
                <TextBox x:Name="Gradient1Box" Width="86" Text="#0050FF" TextChanged="OnGradientTextChanged" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <Border x:Name="Gradient2Preview" Width="22" Height="22" CornerRadius="4" Margin="0,0,6,0" />
                <TextBox x:Name="Gradient2Box" Width="86" Text="#FF00C8" TextChanged="OnGradientTextChanged" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Border x:Name="Gradient3Preview" Width="22" Height="22" CornerRadius="4" Margin="0,0,6,0" />
                <TextBox x:Name="Gradient3Box" Width="86" Text="#00FFB4" TextChanged="OnGradientTextChanged" />
                <TextBlock Text="(vazio = só 2 cores)" VerticalAlignment="Center" Margin="6,0,0,0"
                           Foreground="#9AA0AA" FontSize="11" />
            </StackPanel>
        </StackPanel>

        <!-- App effects that loop -->
        <StackPanel x:Name="CyclePanel" Visibility="Collapsed">
            <TextBlock Text="DURAÇÃO DE UM CICLO" Style="{StaticResource SubHeader}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="52" />
                </Grid.ColumnDefinitions>
                <Slider x:Name="CycleSlider" Minimum="0.5" Maximum="20" Value="4" VerticalAlignment="Center"
                        IsSnapToTickEnabled="True" TickFrequency="0.5" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" FontFamily="Consolas"
                           Text="{Binding Value, ElementName=CycleSlider, StringFormat={}{0:0.0} s}" />
            </Grid>
        </StackPanel>

        <!-- Chip effects on the board -->
        <StackPanel x:Name="SpeedPanel">
            <TextBlock Text="VELOCIDADE" Style="{StaticResource SubHeader}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="lento" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#9AA0AA" />
                <!-- Same scale as RCGTII's speed slider: register 0xAB = 255 - position (1..255). -->
                <Slider x:Name="SpeedSlider" Grid.Column="1" Minimum="0" Maximum="254" VerticalAlignment="Center"
                        IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnSpeedChanged" />
                <TextBlock Grid.Column="2" Text="rápido" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#9AA0AA" />
            </Grid>
            <TextBlock x:Name="SpeedText" FontFamily="Consolas" Foreground="#9AA0AA" Margin="0,2,0,0" />
        </StackPanel>
    </StackPanel>
</UserControl>
