<UserControl x:Class="RacingApp.LedEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <!-- What the strip will look like: the one saturated thing on screen. -->
        <Border Height="132" CornerRadius="3" Background="{StaticResource MaskDeep}" ClipToBounds="True">
            <Grid>
                <Border x:Name="PreviewHalo" Height="46" Margin="36,0" CornerRadius="23" Opacity="0.4"
                        VerticalAlignment="Center" Background="{Binding Background, ElementName=Preview}">
                    <Border.Effect>
                        <BlurEffect Radius="36" />
                    </Border.Effect>
                </Border>
                <Border x:Name="Preview" Height="8" Margin="52,0" CornerRadius="4" VerticalAlignment="Center"
                        Background="{StaticResource Trace}">
                    <Border.Effect>
                        <DropShadowEffect x:Name="PreviewGlow" ShadowDepth="0" BlurRadius="28" Opacity="0.9"
                                          Color="Transparent" />
                    </Border.Effect>
                </Border>
            </Grid>
        </Border>

        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition MinWidth="200" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition MinWidth="220" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Efeito" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="EffectBox" SelectionChanged="OnEffectChanged" />
                <TextBlock x:Name="AppEffectNote" Visibility="Collapsed" Style="{StaticResource Hint}" Margin="0,8,0,0"
                           Text="Calculado pelo Racing Studio: funciona enquanto o app estiver aberto, inclusive minimizado na bandeja." />

                <!-- Chip effects on the board -->
                <StackPanel x:Name="SpeedPanel">
                    <TextBlock Text="Velocidade" Style="{StaticResource FieldLabel}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Lento" Style="{StaticResource Inline}" Margin="0,0,10,0" />
                        <!-- Same scale as RCGTII's speed slider: register 0xAB = 255 - position (1..255). -->
                        <Slider x:Name="SpeedSlider" Grid.Column="1" Minimum="0" Maximum="254" VerticalAlignment="Center"
                                IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnSpeedChanged" />
                        <TextBlock Grid.Column="2" Text="Rápido" Style="{StaticResource Inline}" Margin="10,0,0,0" />
                    </Grid>
                    <TextBlock x:Name="SpeedText" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                </StackPanel>

                <!-- App effects that loop -->
                <StackPanel x:Name="CyclePanel" Visibility="Collapsed">
                    <TextBlock Text="Duração de um ciclo" Style="{StaticResource FieldLabel}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="52" />
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="CycleSlider" Minimum="0.5" Maximum="20" Value="4" VerticalAlignment="Center"
                                IsSnapToTickEnabled="True" TickFrequency="0.5" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource Reading}"
                                   Text="{Binding Value, ElementName=CycleSlider, StringFormat={}{0:0.0} s}" />
                    </Grid>
                </StackPanel>

                <!-- Cor pela temperatura -->
                <StackPanel x:Name="TempPanel" Visibility="Collapsed">
                    <TextBlock Text="Faixa de temperatura da CPU" Style="{StaticResource FieldLabel}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Azul em" Style="{StaticResource Inline}" Margin="0,0,8,0" />
                        <TextBox x:Name="TempMinBox" Width="48" Text="40" />
                        <TextBlock Text="°C, vermelho em" Style="{StaticResource Inline}" Margin="8,0" />
                        <TextBox x:Name="TempMaxBox" Width="48" Text="80" />
                        <TextBlock Text="°C" Style="{StaticResource Inline}" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <!-- Shown for the chips' effects and the app effects that use a single colour. -->
                <StackPanel x:Name="ColorSection">
                    <TextBlock Text="Cor" Style="{StaticResource FieldLabel}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="38" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="R" Style="{StaticResource Reading}" VerticalAlignment="Center" Foreground="#FF7A70" />
                        <Slider x:Name="RedSlider" Grid.Column="1" Maximum="255" VerticalAlignment="Center" Foreground="#FF5A4E"
                                IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnSliderChanged" />
                        <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=RedSlider}" Style="{StaticResource Reading}"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" />
                        <TextBlock Grid.Row="1" Text="G" Style="{StaticResource Reading}" VerticalAlignment="Center" Foreground="#6BDB7B" />
                        <Slider x:Name="GreenSlider" Grid.Row="1" Grid.Column="1" Maximum="255" VerticalAlignment="Center" Foreground="#4CC963"
                                IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnSliderChanged" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Value, ElementName=GreenSlider}" Style="{StaticResource Reading}"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" />
                        <TextBlock Grid.Row="2" Text="B" Style="{StaticResource Reading}" VerticalAlignment="Center" Foreground="#7AAEFF" />
                        <Slider x:Name="BlueSlider" Grid.Row="2" Grid.Column="1" Maximum="255" VerticalAlignment="Center" Foreground="#4F8EFF"
                                IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnSliderChanged" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Value, ElementName=BlueSlider}" Style="{StaticResource Reading}"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Hex" Style="{StaticResource Inline}" Margin="0,0,10,0" />
                        <TextBox x:Name="HexBox" Width="96" KeyDown="OnHexKeyDown" LostFocus="OnHexLostFocus" />
                    </StackPanel>

                    <TextBlock Text="Cores rápidas" Style="{StaticResource FieldLabel}" />
                    <WrapPanel x:Name="Swatches" />
                </StackPanel>

                <!-- Gradiente -->
                <StackPanel x:Name="GradientPanel" Visibility="Collapsed">
                    <TextBlock Text="Cores do gradiente" Style="{StaticResource FieldLabel}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border x:Name="Gradient1Preview" Width="24" Height="24" CornerRadius="3" Margin="0,0,8,0" />
                        <TextBox x:Name="Gradient1Box" Width="96" Text="#0050FF" TextChanged="OnGradientTextChanged" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border x:Name="Gradient2Preview" Width="24" Height="24" CornerRadius="3" Margin="0,0,8,0" />
                        <TextBox x:Name="Gradient2Box" Width="96" Text="#FF00C8" TextChanged="OnGradientTextChanged" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="Gradient3Preview" Width="24" Height="24" CornerRadius="3" Margin="0,0,8,0" />
                        <TextBox x:Name="Gradient3Box" Width="96" Text="#00FFB4" TextChanged="OnGradientTextChanged" />
                        <TextBlock Text="Deixe vazio para usar só 2 cores" Style="{StaticResource Inline}" Margin="10,0,0,0" FontSize="12" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
